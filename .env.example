# Groq API Key (keep this private, do not commit .env to version control)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (default: qwen/qwen3-32b)
GROQ_MODEL=qwen/qwen3-32b

# Allowed parent origins for iframe embedding & CORS (comma-separated).
# Example: https://skillpath-portal.vercel.app,http://localhost:3000
# If left empty, only same-origin framing is permitted.
ALLOWED_ORIGINS=

# Link to portal's human counsellor desk or scheduling page (optional)
# Example: https://skillpath-portal.vercel.app/counsellor
HUMAN_COUNSELLOR_URL=
